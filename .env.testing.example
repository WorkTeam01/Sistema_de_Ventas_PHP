# Configuración de la BD de test MariaDB (tests de integración con funciones
# de fecha específicas de MySQL: CURDATE(), NOW(), YEAR(), DATE_FORMAT(), etc.)
#
# La mayoría de tests de integración usan SQLite in-memory (ver tests/bootstrap.php)
# y no necesitan esto. Solo se usa en tests que extienden
# Tests\Concerns\RefreshMariaDatabase — si esta BD no está disponible, esos
# tests se saltan automáticamente (markTestSkipped), no fallan.
#
# Copiar a .env.testing y ajustar credenciales localmente.
DB_TEST_HOST=127.0.0.1
DB_TEST_PORT=3306
DB_TEST_NAME=sistemadeventas_test
DB_TEST_USER=root
DB_TEST_PASS=
