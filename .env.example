# Configuración de la Base de Datos
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# Configuración de la Aplicación
APP_URL=http://localhost/Sistema_de_Ventas_PHP/public
APP_TIMEZONE=America/La_Paz
APP_VERSION=1.18.3
APP_DEBUG=false
SESSION_LIFETIME=60
REMEMBER_LIFETIME=14

# Umbrales de autenticación (valores por defecto; un valor fuera de rango se ignora).
# REMEMBER_LIFETIME (arriba) son los días de "recordarme" (1-90).
# Login: intentos máximos por correo (1-50) y por IP (1-500) dentro de la ventana en minutos (1-1440)
LOGIN_MAX_PER_EMAIL=5
LOGIN_MAX_PER_IP=20
LOGIN_WINDOW_MINUTES=15
# Restablecimiento de contraseña: vigencia del enlace (5-1440 min), espera entre solicitudes
# del mismo usuario (1-60 min) y solicitudes máximas por IP y hora (1-100)
RESET_TOKEN_MINUTES=60
RESET_COOLDOWN_MINUTES=5
RESET_MAX_PER_IP_HOUR=5

# Moneda mostrada en vistas, PDFs y reportes (ej. "Bs.", "$", "US$", "S/")
APP_CURRENCY_SYMBOL=Bs.

# Configuración de Mail (Opcional)
# IMPORTANTE: Usa una "Contraseña de Aplicación" de Google, no tu contraseña normal.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Sistema de Ventas"